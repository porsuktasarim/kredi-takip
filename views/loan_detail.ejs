<%- include('head') %>
<a href="/loans" class="btn btn-sm btn-link mb-3">&larr; <%= t.back %></a>
<h3><%= loan.name %></h3>
<p>
<%= t.principal %>: <strong><%= loan.principal.toLocaleString() %></strong> |
<%= t.monthly_payment %>: <strong><%= loan.monthlyPayment.toLocaleString() %></strong> |
<%= t.installments %>: <%= loan.installments %><br>
<%= t.total_payment %>: <strong><%= totalPayment.toLocaleString() %></strong> |
<%= t.total_interest %>: <strong><%= totalInterest.toLocaleString() %></strong> |
<%= t.effective_rate %>: <strong>%<%= (rate*100).toFixed(2) %></strong>
</p>

<form method="post" action="/loans/<%= loan.id %>/pay" class="mb-3">
  <button class="btn btn-success"><%= t.pay_installment %></button>
</form>

<table class="table table-sm bg-white shadow-sm">
<thead><tr><th><%= t.installment_no %></th><th><%= t.due_date %></th><th><%= t.monthly_payment %></th><th><%= t.status %></th><th></th></tr></thead>
<tbody>
<% schedule.forEach(s => { %>
<tr class="<%= s.paid ? 'table-success' : '' %>">
<td><%= s.no %></td><td><%= s.date %></td><td><%= s.amount.toLocaleString() %></td>
<td><%= s.paid ? t.done : t.pending %></td>
<td>
  <form method="post" action="/loans/<%= loan.id %>/toggle/<%= s.no %>">
    <button class="btn btn-sm btn-outline-secondary"><%= t.toggle %></button>
  </form>
</td>
</tr>
<% }) %>
</tbody></table>
<%- include('foot') %>
