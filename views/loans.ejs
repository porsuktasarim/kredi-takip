<%- include('head') %>
<h3><%= t.loans %></h3>
<table class="table bg-white shadow-sm">
<thead><tr><th><%= t.name %></th><th><%= t.principal %></th><th><%= t.monthly_payment %></th>
<th><%= t.paid %>/<%= t.installments %></th><th><%= t.remaining %></th><th></th></tr></thead>
<tbody>
<% if (!loans.length) { %><tr><td colspan="6" class="text-muted"><%= t.no_loans %></td></tr><% } %>
<% loans.forEach(l => { %>
<tr>
<td><a href="/loans/<%= l.id %>"><%= l.name %></a></td>
<td><%= l.principal.toLocaleString() %></td>
<td><%= l.monthly.toFixed(2) %></td>
<td><%= l.paid %>/<%= l.installments %></td>
<td><strong><%= l.remaining.toFixed(2) %></strong></td>
<td>
  <form method="post" action="/loans/<%= l.id %>/delete" class="d-inline" onsubmit="return confirm('?')">
    <button class="btn btn-sm btn-outline-danger"><%= t.delete %></button>
  </form>
</td>
</tr>
<% }) %>
</tbody></table>

<h5 class="mt-4"><%= t.add_loan %></h5>
<form method="post" action="/loans/add" class="row g-2">
  <div class="col-md-3"><input class="form-control" name="name" placeholder="<%= t.name %>" required></div>
  <div class="col-md-2"><input class="form-control" type="number" step="0.01" name="principal" placeholder="<%= t.principal %>" required></div>
  <div class="col-md-2"><input class="form-control" type="number" step="0.01" name="rate" placeholder="<%= t.rate %>" value="0"></div>
  <div class="col-md-2"><input class="form-control" type="number" name="installments" placeholder="<%= t.installments %>" required></div>
  <div class="col-md-2"><button class="btn btn-primary w-100"><%= t.save %></button></div>
</form>
<%- include('foot') %>
