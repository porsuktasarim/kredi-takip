<%- include('head') %>
<h3><%= t.loans %></h3>
<table class="table bg-white shadow-sm">
<thead><tr><th><%= t.name %></th><th><%= t.principal %></th><th><%= t.monthly_payment %></th>
<th><%= t.installments %></th><th><%= t.total_payment %></th><th><%= t.total_interest %></th>
<th><%= t.effective_rate %></th><th><%= t.paid %></th><th><%= t.remaining %></th><th></th></tr></thead>
<tbody>
<% if (!loans.length) { %><tr><td colspan="10" class="text-muted"><%= t.no_loans %></td></tr><% } %>
<% loans.forEach(l => { %>
<tr>
<td><a href="/loans/<%= l.id %>"><%= l.name %></a></td>
<td><%= l.principal.toLocaleString() %></td>
<td><%= l.monthlyPayment.toLocaleString() %></td>
<td><%= l.installments %></td>
<td><%= l.totalPayment.toLocaleString() %></td>
<td><%= l.totalInterest.toLocaleString() %></td>
<td>%<%= (l.rate*100).toFixed(2) %></td>
<td><%= l.paidCount %>/<%= l.installments %></td>
<td><strong><%= l.remaining.toLocaleString() %></strong></td>
<td>
  <form method="post" action="/loans/<%= l.id %>/delete" class="d-inline" onsubmit="return confirm('?')">
    <button class="btn btn-sm btn-outline-danger"><%= t.delete %></button>
  </form>
</td>
</tr>
<% }) %>
</tbody></table>

<h5 class="mt-4"><%= t.add_loan %></h5>
<form method="post" action="/loans/add" class="row g-2">
  <div class="col-md-3"><label class="form-label small"><%= t.name %></label><input class="form-control" name="name" required></div>
  <div class="col-md-2"><label class="form-label small"><%= t.principal %></label><input class="form-control" type="number" step="0.01" name="principal" required></div>
  <div class="col-md-2"><label class="form-label small"><%= t.monthly_payment %></label><input class="form-control" type="number" step="0.01" name="monthlyPayment" required></div>
  <div class="col-md-2"><label class="form-label small"><%= t.installments %></label><input class="form-control" type="number" name="installments" required></div>
  <div class="col-md-2"><label class="form-label small"><%= t.start_date %></label><input class="form-control" type="date" name="startDate" required></div>
  <div class="col-md-1"><label class="form-label small">&nbsp;</label><button class="btn btn-primary w-100"><%= t.save %></button></div>
</form>
<%- include('foot') %>
