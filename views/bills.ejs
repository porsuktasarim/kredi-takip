<%- include('head') %>
<h3><%= t.bills %> — <%= month %></h3>
<table class="table bg-white shadow-sm">
<thead><tr><th><%= t.name %></th><th><%= t.amount %></th><th><%= t.due_day %></th><th><%= t.this_month %></th><th></th></tr></thead>
<tbody>
<% if (!bills.length) { %><tr><td colspan="5" class="text-muted"><%= t.no_bills %></td></tr><% } %>
<% bills.forEach(b => { %>
<tr class="<%= b.paidThisMonth ? 'table-success' : '' %>">
<td><%= b.name %></td><td><%= b.amount.toLocaleString() %></td><td><%= b.due_day %></td>
<td>
  <form method="post" action="/bills/<%= b.id %>/toggle" class="d-inline">
    <button class="btn btn-sm <%= b.paidThisMonth ? 'btn-outline-secondary' : 'btn-success' %>">
      <%= b.paidThisMonth ? t.mark_unpaid : t.mark_paid %>
    </button>
  </form>
</td>
<td>
  <form method="post" action="/bills/<%= b.id %>/delete" class="d-inline" onsubmit="return confirm('?')">
    <button class="btn btn-sm btn-outline-danger"><%= t.delete %></button>
  </form>
</td>
</tr>
<% }) %>
</tbody></table>

<h5 class="mt-4"><%= t.add_bill %></h5>
<form method="post" action="/bills/add" class="row g-2">
  <div class="col-md-4"><input class="form-control" name="name" placeholder="<%= t.name %>" required></div>
  <div class="col-md-3"><input class="form-control" type="number" step="0.01" name="amount" placeholder="<%= t.amount %>" required></div>
  <div class="col-md-3"><input class="form-control" type="number" min="1" max="31" name="due_day" placeholder="<%= t.due_day %>" value="1"></div>
  <div class="col-md-2"><button class="btn btn-primary w-100"><%= t.save %></button></div>
</form>
<%- include('foot') %>
